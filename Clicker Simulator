local OrionLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/shlexware/Orion/main/source"))()

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualUser = game:GetService("VirtualUser")

local Utilities = ReplicatedStorage:WaitForChild("Modules"):WaitForChild("Utilities")
local Network = require(Utilities:WaitForChild("ServiceLoader"):WaitForChild("NetworkService"))
local Util = require(Utilities:WaitForChild("UtilityLoader"))
local Click = Network.GetFunction("ClickFunction")
local Rebirth = Network.GetEvent("RebirthEvent")
local Dispenser = Util.GetUtility("dispenserUtility")

local LocalPlayer = Players.LocalPlayer

local DEFAULT_WALKSPEED = 16
local DEFAULT_JUMPPOWER = 50

local settings = {
    autoClick = false,
    autoRebirth = false,
    autoEgg = false,
    rebirthAmount = 1,
    walkSpeedEnabled = false,
    walkSpeed = DEFAULT_WALKSPEED,
    jumpPowerEnabled = false,
    jumpPower = DEFAULT_JUMPPOWER,
}

local function getHumanoid()
    local character = LocalPlayer.Character
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function applyMovement()
    local humanoid = getHumanoid()
    if not humanoid then
        return
    end
    humanoid.WalkSpeed = settings.walkSpeedEnabled and settings.walkSpeed or DEFAULT_WALKSPEED
    humanoid.UseJumpPower = true
    humanoid.JumpPower = settings.jumpPowerEnabled and settings.jumpPower or DEFAULT_JUMPPOWER
end

-- Re-apply movement settings after respawning
LocalPlayer.CharacterAdded:Connect(function(character)
    character:WaitForChild("Humanoid")
    applyMovement()
end)

-- Runs `action` every `delay` seconds while settings[flag] is true.
-- Spawned in its own thread so toggle callbacks (and config loading) never block.
local loopRunning = {}
local function startLoop(flag, delay, action)
    if loopRunning[flag] then
        return
    end
    loopRunning[flag] = true
    task.spawn(function()
        while settings[flag] do
            local ok, err = pcall(action)
            if not ok then
                warn("[12x Ware] " .. flag .. " error: " .. tostring(err))
            end
            task.wait(delay)
        end
        loopRunning[flag] = false
    end)
end

local Window = OrionLib:MakeWindow({Name = "12x Ware", HidePremium = true, SaveConfig = true, ConfigFolder = "ClickerSus"})

-- Main tab
local MainTab = Window:MakeTab({
    Name = "Main",
    Icon = "rbxassetid://4483345998",
    PremiumOnly = false
})

MainTab:AddSection({
    Name = "Features"
})

MainTab:AddToggle({
    Name = "AutoClick",
    Default = false,
    Save = true,
    Flag = "AutoClick",
    Callback = function(Value)
        settings.autoClick = Value
        if Value then
            startLoop("autoClick", 0.01, function()
                Click:Invoke("press")
            end)
        end
    end
})

MainTab:AddToggle({
    Name = "AutoRebirth",
    Default = false,
    Save = true,
    Flag = "AutoRebirth",
    Callback = function(Value)
        settings.autoRebirth = Value
        if Value then
            startLoop("autoRebirth", 0.1, function()
                Rebirth:Fire(settings.rebirthAmount)
            end)
        end
    end
})

MainTab:AddDropdown({
    Name = "Rebirths",
    Default = "1",
    Options = {"1", "5", "20", "80", "400", "2000", "10000", "40000", "100000", "400000"},
    Save = true,
    Flag = "RebirthAmount",
    Callback = function(Value)
        settings.rebirthAmount = tonumber(Value) or 1
    end
})

MainTab:AddToggle({
    Name = "Auto Open Egg",
    Default = false,
    Save = true,
    Flag = "AutoEgg",
    Callback = function(Value)
        settings.autoEgg = Value
        if Value then
            startLoop("autoEgg", 0.1, function()
                Dispenser.HatchEgg(1)
            end)
        end
    end
})

local antiAfkConnection
MainTab:AddToggle({
    Name = "Anti Afk",
    Default = false,
    Save = true,
    Flag = "AntiAfk",
    Callback = function(Value)
        if Value and not antiAfkConnection then
            antiAfkConnection = LocalPlayer.Idled:Connect(function()
                local camera = workspace.CurrentCamera
                VirtualUser:Button2Down(Vector2.new(0, 0), camera.CFrame)
                task.wait(1)
                VirtualUser:Button2Up(Vector2.new(0, 0), camera.CFrame)
            end)
        elseif not Value and antiAfkConnection then
            antiAfkConnection:Disconnect()
            antiAfkConnection = nil
        end
    end
})

